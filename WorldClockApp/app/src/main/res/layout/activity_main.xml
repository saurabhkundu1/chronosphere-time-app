<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#1a237e">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="World Clock"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:id="@+id/cityContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/city1Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New York\n--:--:--"
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/city_card_background"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/city2Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="London\n--:--:--"
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/city_card_background"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/city3Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tokyo\n--:--:--"
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/city_card_background"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/city4Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sydney\n--:--:--"
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/city_card_background"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/city5Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dubai\n--:--:--"
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/city_card_background"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

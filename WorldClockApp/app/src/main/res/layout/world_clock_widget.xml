<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/chrono_hero"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_brand"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/widgetCity1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_city_time"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/city_card_background"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/widgetCity2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_city_time"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/city_card_background"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/widgetCity3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_city_time"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/city_card_background"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/widgetCity4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_city_time"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/city_card_background"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/widgetCity5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_city_time"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/city_card_background"/>

</LinearLayout>
